# ── Local development ──────────────────────────────────────────────────────────
# Backend API manzili (lokal: edums-backend .env dagi PORT)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Yuklangan fayllar uchun asosiy manzil (backend static /uploads)
NEXT_PUBLIC_FILES_URL=http://localhost:4000

